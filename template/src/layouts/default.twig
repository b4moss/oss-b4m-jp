<!DOCTYPE html>
<html lang="en">
<head>

  {% block startHead %}
  {% endblock %}

  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ title | default('Document') }}</title>
  <link rel="stylesheet" href="/src/assets/styles/main.css">

  {% block endHead %}
  {% endblock %}
</head>
<body>
  {% block startBody %}
  {% endblock %}

  {% block header %}
  {% endblock %}
  
  <main class="dashi-main">
  {% block main %}
  {% endblock %}
  </main>

  {% block footer %}
  {% endblock %}

  {% block endBody %}
  {% endblock %}
  <script src="/src/assets/scripts/main.ts"></script>
  {% block lastScripts %}
  {% endblock %}
</body>
</html>